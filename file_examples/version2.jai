// Build this file with +Serialize

f32 :: float32;
f64 :: float64;

#import "Basic";
#import "File";

       // Here's a text thing
  // Here's another text thing



Building :: struct @Serialize {
    VERSION :: 3;

    position_x:  f32;
    position_y:  f32;
    orientation: f32;

    __OBSOLETE__vertical_offset: f32;            @v2_3
    offset_x: f32;                               @v3
    offset_y: f32;                               @v3
    // TODO(jt): Can we read from other fields here? Maybe if we replace this at compile time?
    // offset_y: f32 = __OBSOLETE__vertical_offset; @v3

    num_floors: s32;
    dim_x_in_modules: s32;
    dim_y_in_modules: s32;
}

// TODO(jt): Think about how we'd support serializing custom types. Maybe we just rely on that a
// read/write_xyz procedure is already defined in the target module? And if it is generated by us,
// why not? People can also hand-write them, and we should also have the option of generating
// unversioned read/write_xyz for structs that don't need that, so that people can still do Vec2 ::
// struct @Serialize, but not output the version.

//////////////////////////////////////

read_f32 :: (bytes: *[] u8) -> success: bool, f32 {
    success, value := read_4b(bytes);
    return success, cast(*f32, *value).*;
}

read_s64 :: (bytes: *[] u8) -> success: bool, s64 {
    success, value := read_8b(bytes);
    return success, cast(*s64, *value).*;
}

read_s32 :: (bytes: *[] u8) -> success: bool, s32 {
    success, value := read_4b(bytes);
    return success, cast(*s32, *value).*;
}

read_8b :: (bytes: *[] u8) -> success: bool, [8] u8 {
    if bytes.count < 8 {
        return false, .[0, 0, 0, 0, 0, 0, 0, 0];
    }

    p := cast(*[8] u8, bytes.data);
    value := p.*;

    array_advance(bytes, 8);

    return true, value;
}

read_4b :: (bytes: *[] u8) -> success: bool, [4] u8 {
    if bytes.count < 4 {
        return false, .[0, 0, 0, 0];
    }

    p := cast(*[4] u8, bytes.data);
    value := p.*;

    array_advance(bytes, 4);

    return true, value;
}

array_advance :: (array: *[] $T, amount: s64) {
    assert(amount >= 0);
    assert(array.count >= amount);

    array.count -= amount;
    array.data  += amount;
}

//////////////////////////////////////

write_f32 :: (bytes: *[..] u8, value: f32) {
    inline write_4b(bytes, value);
}

write_s64 :: (bytes: *[..] u8, value: s64) {
    inline write_8b(bytes, value);
}

write_s32 :: (bytes: *[..] u8, value: s32) {
    inline write_4b(bytes, value);
}

// TODO(jt): Check size of value with #modify ???

write_8b :: (bytes: *[..] u8, value: $T) {
    #assert size_of(T) == 8;
    array := cast(*[8] u8, *value);

    // TODO(jt): Do a block copy
    for array.* {
        array_add(bytes, it);
    }
}

write_4b :: (bytes: *[..] u8, value: $T) {
    #assert size_of(T) == 4;
    array := cast(*[4] u8, *value);

    // TODO(jt): Do a block copy
    for array.* {
        array_add(bytes, it);
    }
}

/////////////////////////////////////

