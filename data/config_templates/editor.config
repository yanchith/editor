1 # Version number, do not remove.

#
# This is the user config for the editor. Eventually, there will also be a project config.
#
# For now, you can set your keybindings, theme and a couple of other things. The list of
# customizable things will grow. If you are willing to compile your own build, you can
# try modifying constants tagged with :Config to get a taste.
#
# Keybindings are organized in various sections, depending on what context you are in,
# e.g. whether you are editing a text file, or seeing a directory listing.
# This is a little overwhelming on the user side, and I will try to simplify this.
#
# You can reload this config by running the reload_config command.
#

theme = abulafia   # abulafia, naysayer, handmade, stb, ...

# Directories to ignore by open_file_in_project and search_in_project.
# Semicolon separated list of directories, e.g. .git;.build;target;tmp
project_search_ignore_directories = .git;.build

[macos]

# To invoke compilers for *compilation* or rg for directory search, we use execvp() on macOS.
# However, when launched as an .app, We don't inherit the shell's path, so we won't be able to
# find the external tools you can access from the shell. Tell us the search path here:
#
# search_path                            = /bin:/usr/bin:/usr/local/bin

[keybinds.panel]

M-x                                    = show_commands
C-S-p                                  = show_commands
C-s                                    = search

C-x C-f                                = open_file
C-x b                                  = switch_view
C-x k                                  = close_view

C-l                                    = recenter
M-v                                    = move_up_one_screen
<pageup>                               = move_up_one_screen
C-v                                    = move_down_one_screen
<pagedown>                             = move_down_one_screen

C-x 3                                  = split_panel_horizontally
C-x 0                                  = close_current_panel
C-x 1                                  = close_other_panels
C-x o                                  = go_to_other_panel

C-x p f                                = open_file_in_project
C-x p s                                = search_in_project
C-c s r                                = search_in_project  # For Jan's muscle memory from the Emacs days
C-x p c                                = compile_in_project_or_directory

C-+                                    = font_size_increase
C--                                    = font_size_decrease

<f1>                                   = debug_view_atlas_texture
<f2>                                   = debug_view_memory_absolute
<f3>                                   = debug_view_memory_relative
<f4>                                   = debug_view_frame_profile
<f5>                                   = debug_view_frame_timeline

[keybinds.document]

C-p                                    = move_up
<up>                                   = move_up
C-n                                    = move_down
<down>                                 = move_down
C-f                                    = move_forward
<right>                                = move_forward
C-b                                    = move_backward
<left>                                 = move_backward

C-a                                    = move_to_start_of_line
C-e                                    = move_to_end_of_line

M-<                                    = move_to_start
<home>                                 = move_to_start
M->                                    = move_to_end
<end>                                  = move_to_end

M-f                                    = move_forward_word
C-<right>                              = move_forward_word
M-b                                    = move_backward_word
C-<left>                               = move_backward_word

M-p                                    = move_to_previous_blank_line
M-n                                    = move_to_next_blank_line

C-M-b                                  = move_to_start_of_scope
C-M-f                                  = move_to_end_of_scope

# TODO(jt): This should be 'C-:', but Windows doesn't fire a WM_CHAR event for 'Ctrl-:', and we'd have
# to manually translate 'Ctrl-Shift-;' to 'Ctrl-:'... This needs to improve. Until then, use ';' instead.
C-;                                    = expand_selection

M-%                                    = search_and_replace

C-x C-s                                = save_document
C-x C-r                                = reload_document

C-M-p                                  = swap_line_up
C-M-n                                  = swap_line_down

M-g g                                  = go_to_line

C-<space>                              = start_selecting
C-g                                    = stop_selecting
<escape>                               = stop_selecting

C-d                                    = delete_forward
<delete>                               = delete_forward
<backspace>                            = delete_backward

M-d                                    = delete_forward_word
C-<backspace>                          = delete_backward_word
M-<backspace>                          = delete_backward_word

C-k                                    = delete_line
C-j                                    = join_next_line

C-m                                    = insert_line_before
<enter>                                = insert_line_before
C-o                                    = insert_line_after

C-i                                    = indent_or_autocomplete
<tab>                                  = indent_or_autocomplete

C-x C-;                                = toggle_comment

C-u C-<space>                          = pop_cursor_location

C-/                                    = undo_edit
C-z                                    = undo_edit
M-/                                    = redo_edit
C-S-z                                  = redo_edit

M-w                                    = copy
C-w                                    = cut
C-y                                    = paste

C-x C-q                                = toggle_readonly

[keybinds.compilation]

C-p                                    = move_up
<up>                                   = move_up
C-n                                    = move_down
<down>                                 = move_down
C-f                                    = move_forward
<right>                                = move_forward
C-b                                    = move_backward
<left>                                 = move_backward

C-a                                    = move_to_start_of_line
C-e                                    = move_to_end_of_line

M-<                                    = move_to_start
<home>                                 = move_to_start
M->                                    = move_to_end
<end>                                  = move_to_end

M-f                                    = move_forward_word
C-<right>                              = move_forward_word
M-b                                    = move_backward_word
C-<left>                               = move_backward_word

M-p                                    = move_to_previous_error
p                                      = move_to_previous_error
M-n                                    = move_to_next_error
n                                      = move_to_next_error

# TODO(jt): This should be 'C-:', but Windows doesn't fire a WM_CHAR event for 'Ctrl-:', and we'd have
# to manually translate 'Ctrl-Shift-;' to 'Ctrl-:'... This needs to improve. Until then, use ';' instead.
C-;                                    = expand_selection

C-<space>                              = start_selecting
C-g                                    = stop_selecting
<escape>                               = stop_selecting

M-w                                    = copy
C-w                                    = copy

C-m                                    = go_to_current_error
<enter>                                = go_to_current_error

g                                      = refresh
C-r                                    = refresh

[keybinds.listing]

C-p                                    = move_up
p                                      = move_up
<up>                                   = move_up
C-n                                    = move_down
n                                      = move_down
<down>                                 = move_down

C-m                                    = open
<enter>                                = open
C-o                                    = open_in_other_panel

d                                      = mark_item
u                                      = unmark_item
x                                      = delete_marked_items

g                                      = refresh
C-r                                    = refresh

