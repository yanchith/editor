1 # Version number, do not remove.

#
# This is the user config for the editor. Eventually, there will also be a project config.
#
# For now, you can set your keybindings, theme and a couple of other things. The list of
# customizable things will grow. If you are willing to compile your own build, you can
# try modifying constants tagged with :Config to get a taste.
#
# Keybindings are organized in various sections, depending on what context you are in,
# e.g. whether you are editing a text file, or seeing a directory listing.
# This is a little overwhelming on the user side, and I will try to simplify this.
#
# You can reload this config by running the reload_config command.
#

theme = abulafia   # abulafia, naysayer, handmade, stb, ...

# Directories to ignore by open_file_in_project and search_in_project.
# Semicolon separated list of directories, e.g. .git;.build;target;tmp
project_search_ignore_directories = .git;.build

[macos]

# To invoke compilers for *compilation* or rg for directory search, we use execvp() on macOS.
# However, when launched as an .app, We don't inherit the shell's path, so we won't be able to
# find the external tools you can access from the shell. Tell us the search path here:
#
# search_path                            = /bin:/usr/bin:/usr/local/bin

[keybinds.panel]

Ctrl-Shift-p                           = show_commands
Ctrl-f                                 = search

Ctrl-o                                 = open_file_or_directory
Ctrl-<tab>                             = switch_view
Ctrl-w                                 = close_view

Ctrl-k Ctrl-c                          = recenter
<pageup>                               = move_up_one_screen
<pagedown>                             = move_down_one_screen

Alt-Shift 2                            = split_panel_horizontally
Alt-Shift 1                            = close_other_panels
Ctrl-k Ctrl-<down>                     = close_current_panel
Ctrl-k Ctrl-<right>                    = go_to_other_panel

Ctrl-p                                 = open_file_in_project
Ctrl-Shift-f                           = search_in_project
Ctrl-b                                 = compile_in_project_or_directory
Ctrl-Shift-b                           = compile_in_project_or_directory

Ctrl-+                                 = font_size_increase
Ctrl-Shift-+                           = font_size_decrease

<f1>                                   = debug_view_atlas_texture
<f2>                                   = debug_view_memory_absolute
<f3>                                   = debug_view_memory_relative
<f4>                                   = debug_view_frame_profile
<f5>                                   = debug_view_frame_timeline

[keybinds.document]

<up>                                   = move_up
<down>                                 = move_down
<right>                                = move_forward
<left>                                 = move_backward

<home>                                 = move_to_start_of_line
<end>                                  = move_to_end_of_line

Ctrl-<right>                           = move_forward_word
Ctrl-<left>                            = move_backward_word

Ctrl-h                                 = search_and_replace

Ctrl-s                                 = save_document

Ctrl-Shift-<up>                        = swap_line_up
Ctrl-Shift-<down>                      = swap_line_down

Ctrl-g                                 = go_to_line

<delete>                               = delete_forward
<backspace>                            = delete_backward

C-<delete>                             = delete_forward_word
C-<backspace>                          = delete_backward_word

Ctrl-k Ctrl-k                          = delete_line
Ctrl-Shift-j                           = join_next_line

<enter>                                = insert_line_before

Ctrl-]                                 = indent_or_autocomplete
<tab>                                  = indent_or_autocomplete

Ctrl-/                                 = toggle_comment

Ctrl-z                                 = undo_edit
Ctrl-Shift-z                           = redo_edit

Ctrl-c                                 = copy
Ctrl-x                                 = cut
Ctrl-v                                 = paste

[keybinds.compilation]

<up>                                   = move_up
<down>                                 = move_down
<right>                                = move_forward
<left>                                 = move_backward

<home>                                 = move_to_start_of_line
<end>                                  = move_to_end_of_line

Ctrl-<right>                           = move_forward_word
C-<left>                               = move_backward_word

Ctrl-c                                 = copy
Ctrl-x                                 = copy

b                                      = refresh
Ctrl-b                                 = refresh

[keybinds.listing]

<up>                                   = move_up
<down>                                 = move_down

<enter>                                = open

g                                      = refresh
Ctrl-r                                 = refresh

[keybinds.mini_panel]

<up>                                   = move_up
<down>                                 = move_down
<right>                                = move_forward
<left>                                 = move_backward

<home>                                 = move_to_start_of_line
<end>                                  = move_to_end_of_line

Ctrl-<right>                           = move_forward_word
Ctrl-<left>                            = move_backward_word

<pageup>                               = move_up_one_screen
<pagedown>                             = move_down_one_screen

<delete>                               = delete_forward
<backspace>                            = delete_backward

Ctrl-<delete>                          = delete_forward_word
Ctrl-<backspace>                       = delete_backward_word

Ctrl-]                                 = indent_or_autocomplete
<tab>                                  = indent_or_autocomplete

Ctrl-c                                 = copy
Ctrl-x                                 = cut
Ctrl-v                                 = paste

<enter>                                = confirm
<escape>                               = cancel_or_stop_selecting

[keybinds.modal_interaction]

<right>                                = move_forward
<left>                                 = move_backward

<home>                                 = move_to_start_of_line
<end>                                  = move_to_end_of_line

Ctrl-<right>                           = move_forward_word
Ctrl-<left>                            = move_backward_word

<delete>                               = delete_forward
<backspace>                            = delete_backward

Ctrl-<delete>                          = delete_forward_word
Ctrl-<backspace>                       = delete_backward_word

Ctrl-]                                 = indent_or_autocomplete
<tab>                                  = indent_or_autocomplete

Ctrl-c                                 = copy
Ctrl-x                                 = cut
Ctrl-v                                 = paste

<enter>                                = confirm
<escape>                               = cancel_or_stop_selecting
